        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kafka-lab-prometheus"
          },
          "expr": "kafka_lab_double_applied_total",
          "legendFormat": "double applied \u2014 the defect"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "kafka-lab-prometheus"
          },
          "expr": "kafka_lab_duplicates_suppressed_total",
          "legendFormat": "suppressed \u2014 the fix"
        },
