{
  "uid": "kafka-lab-main",
  "title": "kafka-lab",
  "description": "Throttle the consumer below the producer and lag climbs. Open it back up and lag drains. The top panel tells that whole story on its own; everything below it is supporting detail.",
  "tags": [
    "kafka-lab"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "The whole story: produce rate, consume rate, and lag",
      "description": "Produced and consumed are MEASUREMENTS in messages per second, on the left axis. Lag is a MEASUREMENT in messages, on the right axis \u2014 a different unit, which is why it has its own axis rather than being squashed onto a scale it does not share. When the green line drops below the blue one, the orange line climbs. That gap is backpressure.",
      "datasource": {
        "type": "prometheus",
        "uid": "kafka-lab-prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "left",
            "axisLabel": "messages / second"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "produced /sec (measured)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#58a6ff"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "consumed /sec (measured)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3fb950"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "consumer group lag (messages)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#f0883e"
                }
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "messages behind"
              },
              {
                "id": "custom.fillOpacity",
                "value": 18
              },
              {
                "id": "custom.lineWidth",
                "value": 3
